pipeline {

    agent any

    environment {
        APP_NAME       = 'cicd-demo'
        REGISTRY       = 'anujjain07'
        IMAGE_NAME     = "anujjain07/cicd-demo"
        SONAR_HOST_URL = 'http://98.84.97.25:9000'
        SONAR_TOKEN    = credentials('sonar-token')
        NEXUS_URL      = 'http://98.84.97.25:8081'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_SHA   = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.APP_VERSION = "1.0.${BUILD_NUMBER}"
                    env.IMAGE_TAG   = "${env.APP_VERSION}-${env.SHORT_SHA}"
                    echo "Branch:  ${env.BRANCH_NAME}"
                    echo "Version: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Secret Scan') {
            steps {
                sh '''
                    docker run --rm \
                      -v "$(pwd)":/repo \
                      zricethezav/gitleaks:latest \
                      detect --source /repo \
                      --report-format json \
                      --report-path /repo/gitleaks-report.json \
                      --exit-code 0
                    echo "Secret scan complete"
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('Build') {
            steps {
                dir('app') {
                    sh 'mvn clean compile -q'
                }
            }
        }

        stage('Test') {
            steps {
                dir('app') {
                    sh 'mvn test jacoco:report'
                }
            }
            post {
                always {
                    junit 'app/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Code Quality') {
            steps {
                dir('app') {
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \
                              -Dsonar.projectKey=${APP_NAME} \
                              -Dsonar.projectName=${APP_NAME} \
                              -Dsonar.projectVersion=${env.APP_VERSION} \
                              -Dsonar.host.url=${SONAR_HOST_URL} \
                              -Dsonar.token=${SONAR_TOKEN}
                        """
                    }
                }
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Package') {
            steps {
                dir('app') {
                    sh 'mvn package -DskipTests -q'
                    archiveArtifacts artifacts: 'target/*.jar'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh """
                        docker build \
                          --label app.version=${env.IMAGE_TAG} \
                          --label git.sha=${env.SHORT_SHA} \
                          --label git.branch=${env.BRANCH_NAME} \
                          --label build.number=${BUILD_NUMBER} \
                          -t ${IMAGE_NAME}:${env.IMAGE_TAG} \
                          -t ${IMAGE_NAME}:latest \
                          .
                    """
                }
            }
        }

        stage('Image Scan') {
            steps {
                sh """
                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      aquasec/trivy:latest image \
                      --severity HIGH,CRITICAL \
                      --format table \
                      --exit-code 0 \
                      ${IMAGE_NAME}:${env.IMAGE_TAG} | tee trivy-report.txt
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-report.txt',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('Push Image') {
            when {
                anyOf { branch 'main'; branch 'develop' }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'registry-credentials',
                    usernameVariable: 'REG_USER',
                    passwordVariable: 'REG_PASS'
                )]) {
                    sh """
                        echo "${REG_PASS}" | docker login -u ${REG_USER} --password-stdin
                        docker push ${IMAGE_NAME}:${env.IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Upload to Nexus') {
            when {
                anyOf { branch 'main'; branch 'develop' }
            }
            steps {
                dir('app') {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh """
                            curl -u "${NEXUS_USER}:${NEXUS_PASS}" \
                              --upload-file target/${APP_NAME}-1.0.0.jar \
                              "${NEXUS_URL}/repository/maven-releases/com/demo/${APP_NAME}/${env.APP_VERSION}/${APP_NAME}-${env.APP_VERSION}.jar"
                            echo "Artifact uploaded: ${APP_NAME}-${env.APP_VERSION}.jar"
                        """
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            when {
                anyOf { branch 'main'; branch 'develop' }
            }
            steps {
                script {
                    def namespace  = (env.BRANCH_NAME == 'main') ? 'production' : 'development'
                    def valuesFile = (env.BRANCH_NAME == 'main') ? 'helm/values-prod.yaml' : 'helm/values-dev.yaml'
                    sh """
                        kubectl get namespace ${namespace} || \
                          kubectl create namespace ${namespace}

                        helm upgrade --install ${APP_NAME} ./helm \
                          --namespace ${namespace} \
                          --values ${valuesFile} \
                          --set image.repository=${IMAGE_NAME} \
                          --set image.tag=${env.IMAGE_TAG} \
                          --set app.version=${env.APP_VERSION} \
                          --atomic \
                          --timeout 5m \
                          --wait

                        kubectl rollout status deployment/${APP_NAME} \
                          -n ${namespace} --timeout=3m
                    """
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.IMAGE_TAG) {
                    sh "docker rmi ${IMAGE_NAME}:${env.IMAGE_TAG} || true"
                }
            }
            cleanWs()
        }
        success { echo "SUCCESS - ${APP_NAME}" }
        failure { echo "FAILED - check logs above" }
    }
}
